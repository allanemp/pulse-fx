# Usado pelo docker-compose.yml na raiz do monorepo.
# Copie para ".env" e ajuste conforme necessário: `cp .env.example .env`

POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=pulsefx
POSTGRES_DB=pulsefx
POSTGRES_PORT=5432

REDIS_PORT=6379
# UI web opcional do Redis: docker compose up -d redis-commander
REDIS_COMMANDER_PORT=8081

API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# Segredo compartilhado entre api e web (o compose usa o mesmo valor para
# API_TOKEN da API e VITE_API_TOKEN do build do frontend — precisam bater).
# Gere um valor novo para cada ambiente real com: openssl rand -hex 32
API_TOKEN=a3c195592e348f4e83eaa82956c6d077cc747c3852b6daa44fd64214ec3c294b

# FRED (Federal Reserve Economic Data, EUA) — opcional, só necessária se
# algum indicador usar source "fred". Crie uma gratuita em
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

WEB_PORT=5173
VITE_API_URL=http://localhost:3333
