# Usado pelo docker-compose.prod.yml (deploy em produção via Cloudflare Tunnel).
# Copie para ".env.production" e preencha com valores reais:
#   cp .env.production.example .env.production
#
# NUNCA commite o ".env.production" real (já está no .gitignore).

# --- Banco de dados ---
POSTGRES_USER=pulsefx
# Gere uma senha forte: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pulsefx

# --- Domínios públicos (os mesmos hostnames configurados no túnel Cloudflare) ---
CORS_ORIGIN=https://app.seudominio.com
VITE_API_URL=https://api.seudominio.com

# --- Segredo compartilhado entre api e web ---
# Gere um valor novo (não reaproveite o de dev): openssl rand -hex 32
API_TOKEN=troque-este-token

# --- FRED (Federal Reserve Economic Data, EUA) ---
# Opcional: só necessária se algum indicador usar source "fred" (ex.: o seed
# do Fed Funds Rate). Gratuita em https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Cloudflare Tunnel ---
# Token do túnel nomeado, gerado no dashboard da Cloudflare Zero Trust
# (Networks > Tunnels > Create a tunnel > Docker). Ver README.md para o
# passo a passo completo.
CLOUDFLARE_TUNNEL_TOKEN=troque-este-token-do-tunnel
