# Copie para ".env": `cp .env.example .env`
# Usado ao rodar a API fora do Docker (ex.: `npm run dev:api`).

NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://pulsefx:pulsefx@localhost:5432/pulsefx?schema=public
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Redis usado pela fila BullMQ de sincronização diária de indicadores (ver
# src/infrastructure/queue) e pelo cache de leitura da API (ver
# src/infrastructure/cache). Pode usar `docker compose up redis` para subir
# só o Redis localmente.
REDIS_URL=redis://localhost:6379

# TTL (segundos) do cache de GET /api/indicators e
# GET /api/indicators/{id}/observations — ver src/infrastructure/cache.
# Rede de segurança: as escritas já invalidam o cache explicitamente, o TTL
# só garante que ele nunca fica desatualizado por muito tempo mesmo se
# alguma invalidação falhar.
CACHE_TTL_SECONDS=300

# Segredo compartilhado com o frontend (ver apps/web/.env.example: VITE_API_TOKEN
# deve ter o MESMO valor). Obrigatório — a API não sobe sem isso definido.
# Gere um valor novo para cada ambiente real com: openssl rand -hex 32
API_TOKEN=a3c195592e348f4e83eaa82956c6d077cc747c3852b6daa44fd64214ec3c294b

# Domínios base das APIs de dados abertos do Banco Central — cada uma é um
# serviço/domínio diferente do BCB (ver BcbSgsIndicatorDataSource e
# BcbPtaxIndicatorDataSource). O complemento de cada indicador (URL ou data,
# depende da fonte) fica em indicators.source_endpoint, não aqui.
BCB_API_BASE_URL=https://api.bcb.gov.br
BCB_PTAX_API_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata

# FRED (Federal Reserve Economic Data, EUA) — ver FredIndicatorDataSource.
# Diferente do BCB, exige uma api_key por requisição: crie uma gratuita em
# https://fredaccount.stlouisfed.org/apikeys. Opcional: só é necessária se
# algum indicador estiver cadastrado com source "fred" (ex.: o seed do Fed
# Funds Rate).
FRED_API_BASE_URL=https://api.stlouisfed.org/fred
FRED_API_KEY=
