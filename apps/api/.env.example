# Copie para ".env": `cp .env.example .env`
# Usado ao rodar a API fora do Docker (ex.: `npm run dev:api`).

NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://pulsefx:pulsefx@localhost:5432/pulsefx?schema=public
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Segredo compartilhado com o frontend (ver apps/web/.env.example: VITE_API_TOKEN
# deve ter o MESMO valor). Obrigatório — a API não sobe sem isso definido.
# Gere um valor novo para cada ambiente real com: openssl rand -hex 32
API_TOKEN=a3c195592e348f4e83eaa82956c6d077cc747c3852b6daa44fd64214ec3c294b

# Domínio base das APIs de dados abertos do Banco Central (usado pelo seed
# em prisma/seed.ts). O complemento de cada série fica em indicators.source_endpoint.
BCB_API_BASE_URL=https://api.bcb.gov.br
