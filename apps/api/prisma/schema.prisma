// Schema do Prisma — camada de infraestrutura.
// O restante do código nunca importa os tipos gerados aqui diretamente:
// eles são mapeados para as entidades de domínio em
// `src/infrastructure/database/repositories`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExchangeRate {
  id            String   @id @default(uuid())
  baseCurrency  String   @map("base_currency") @db.VarChar(3)
  quoteCurrency String   @map("quote_currency") @db.VarChar(3)
  rate          Decimal  @db.Decimal(18, 8)
  capturedAt    DateTime @map("captured_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([baseCurrency, quoteCurrency, capturedAt])
  @@map("exchange_rates")
}

/// Catálogo de indicadores (ex.: SELIC, IPCA, CDI) — cada um com sua série de observações.
model Indicator {
  id             String   @id @default(uuid())
  name           String   @unique
  /// Unidade/moeda de exibição do valor (ex.: "% a.a.", "BRL").
  unit           String?
  /// Texto explicando o que é a série, a fonte original (ex.: BCB, FRED) e
  /// ressalvas sobre os dados (ex.: frequência de atualização).
  description    String?
  /// Complemento de URL específico deste indicador na fonte externa (ex.: BCB SGS),
  /// combinado em runtime com o domínio base configurado via env (ex.: BCB_API_BASE_URL).
  sourceEndpoint String?  @map("source_endpoint")
  createdAt      DateTime @default(now()) @map("created_at")

  observations Observation[]
  favorite     Favorite?

  @@map("indicators")
}

/// Um valor observado de um indicador em uma data específica (série temporal).
model Observation {
  id          String   @id @default(uuid())
  indicatorId String   @map("indicator_id")
  date        DateTime @db.Date
  value       Decimal  @db.Decimal(18, 8)
  createdAt   DateTime @default(now()) @map("created_at")

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, date])
  @@map("observations")
}

/// Marca um indicador como favorito. Sem sistema de usuários no projeto, é
/// um estado global por indicador (não por usuário) — a existência da linha
/// já é o "favoritado", por isso `indicatorId` é único (um indicador só pode
/// ter uma linha de favorito).
model Favorite {
  id          String   @id @default(uuid())
  indicatorId String   @unique @map("indicator_id")
  createdAt   DateTime @default(now()) @map("created_at")

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@map("favorites")
}
